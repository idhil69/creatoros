# Salin jadi .env : cp .env.example .env
# Daftar tujuan multistream, dipisah tanda | (pipe). Format: URL server + / + stream key.
# YouTube pakai key PERMANEN "CreatorOS Persistent" (lihat panel merah di aplikasi, tidak berubah).

RTMP_TARGETS=rtmps://a.rtmps.youtube.com:443/live2/GANTI-KEY-YOUTUBE|rtmps://live-api-s.facebook.com:443/rtmp/GANTI-KEY-FACEBOOK

# Contoh lengkap 4 platform:
# RTMP_TARGETS=rtmps://a.rtmps.youtube.com:443/live2/xxxx|rtmps://live-api-s.facebook.com:443/rtmp/FB-xxxx|rtmps://edgetee-upload-xxx.instagram.com:443/rtmp/17xxx|rtmp://push-rtmp-xxx.tiktokcdn.com/live/stream-xxxx
