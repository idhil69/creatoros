# ===== Template environment variables =====
# Salin file ini menjadi .env (lokal) atau isi di Vercel → Settings → Environment Variables.
# JANGAN commit file .env yang sudah terisi!

# WAJIB — PostgreSQL connection string (lokal atau Neon)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# WAJIB di produksi — kunci enkripsi token sosmed (buat sendiri: openssl rand -base64 32)
TOKEN_SECRET=

# Disarankan di produksi — URL aplikasi tanpa slash akhir
APP_URL=

# ===== OAuth asli (opsional — tanpa ini platform berjalan mode mock) =====
# Panduan lengkap: docs/OAUTH_SETUP.md

# YouTube (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook & Instagram (developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
